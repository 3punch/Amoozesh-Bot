# ==============================================================================
# Amoozesh-Bot — متغیرهای محیطی (نسخه‌ی نمونه)
# فایل را به .env کپی کرده و مقادیر را تنظیم کنید.
# ==============================================================================

# --- تلگرام (الزامی) ---
TELEGRAM_BOT_TOKEN=123456:ABC-DEF1234ghIkl-zyx57W2v1u123ew11

# --- مدل محلی (Ollama) ---
MODEL_NAME=qwen2.5:7b
OLLAMA_HOST=http://127.0.0.1:11434
NUM_CTX=8192
MAX_TOKENS=320
TEMPERATURE=0.2
LLM_TIMEOUT=300
OLLAMA_KEEP_ALIVE=6h
THINK=0

# --- API ابری (اختیاری؛ بدون کلید غیرفعال است) ---
API_KEY=
API_MODEL=qwen/qwen-2.5-72b-instruct
API_BASE_URL=https://openrouter.ai/api/v1
API_TIMEOUT=120
API_MAX_TOKENS=700

# --- بازیابی داده (Retrieval) ---
MAX_CONTEXT_CHARS=4000
MAX_PROFESSOR_BLOCKS=2
MAX_COURSE_ROWS=5
DEEP_CONTEXT_CHARS=14000
DEEP_MAX_TOKENS=500
DEEP_NUM_CTX=8192
DEEP_TIMEOUT=900

# --- سهمیه (Quota) ---
QUOTA_STATE_PATH=.state/quotas.json
QUOTA_STATE_BRANCH=bot-state
QUOTA_PERSIST=1
KEEP_DAYS=3

# --- زمان اجرای ربات (دقیقه؛ ۰ = تا متوقف شدن دستی) ---
RUN_DURATION_MINUTES=0

# --- حالت‌های فعال/غیرفعال ---
MODEL_SUMMARY=0
DEEP_MODE=1

# --- عمومی ---
DATA_DIR=.
LOG_LEVEL=INFO
QUOTA_PERSIST=1